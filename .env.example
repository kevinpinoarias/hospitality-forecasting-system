# Copy to .env and fill in real values. .env is gitignored - never commit it.

# Required to run the chat assistant (src/assistant/query_forecast.py,
# agent_forecast.py, app.py). Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# Optional. Base URL the assistant calls for /predict. Defaults to
# http://localhost:8000 (a locally running `uvicorn src.api.main:app`) if
# unset - deliberately NOT the public portfolio's live deployment, so
# product-side work never silently depends on that separate service.
# Set this once a real product API is deployed.
FORECAST_API_BASE_URL=
