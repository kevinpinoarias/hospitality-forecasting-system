# Copy to .env and fill in real values. .env is gitignored - never commit it.

# Required to run the chat assistant (src/assistant/query_forecast.py,
# agent_forecast.py, app.py). Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# Optional. Base URL the assistant calls for /predict. Defaults to the live
# API on Cloud Run if unset; set it to http://localhost:8000 to use a locally
# running `uvicorn src.api.main:app` instead.
FORECAST_API_BASE_URL=
